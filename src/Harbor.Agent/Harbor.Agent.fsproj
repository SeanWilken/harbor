<Project Sdk="Microsoft.NET.Sdk">
  <!-- The lean agent for edge machines (Raspberry Pi and up): no web server, no database code.
       Publish: dotnet publish src/Harbor.Agent -c Release -r linux-arm64 (or linux-x64, win-x64). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>harbor-agent</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!-- small and quiet: one GC heap, no ICU (minimal Pi images often lack libicu) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Trim the framework only: F# records and FSharp.SystemTextJson use reflection, so our
         assemblies and theirs are kept whole. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Harbor.Core/Harbor.Core.fsproj" />
  </ItemGroup>
</Project>
